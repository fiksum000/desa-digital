APP_NAME="DESA DIGITAL"
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=http://localhost:8080
APP_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

WEB_PORT=8080
DB_HOST=db
DB_PORT=3306
DB_NAME=desa_digital
DB_USER=desa_app
DB_PASSWORD=replace-with-long-random-app-password
DB_ROOT_PASSWORD=replace-with-different-long-random-root-password

UPLOAD_MAX_MB=5
# Keep false only for local HTTP. Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
